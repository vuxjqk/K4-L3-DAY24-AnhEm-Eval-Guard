# Required
OPENAI_API_KEY=

# Phase A evaluator in the imported m4 uses Gemini.
# GOOGLE_API_KEY is also accepted as a fallback by config.py.
GEMINI_API_KEY=
# Optional overrides; uncomment and set actual values when needed.
# GEMINI_MODEL=your-enabled-model-id
# GEMINI_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Optional: HuggingFace token (only if using HF Inference Endpoints)
HF_TOKEN=

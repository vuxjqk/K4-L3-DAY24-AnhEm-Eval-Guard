# Required: generation (setup_answers), Phase B judge, Phase C NeMo guard
OPENAI_API_KEY=

# Required: m4 RAGAS evaluator + m5 enrichment
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_RPM=12

# Optional: chỉ có key Gemini -> trỏ client OpenAI sang endpoint OpenAI-compatible của Gemini
# OPENAI_API_KEY=<gemini key>
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# GENERATION_MODEL=gemini-3.5-flash-lite
# JUDGE_MODEL=gemini-3.5-flash-lite

# Optional: HuggingFace token (only if using HF Inference Endpoints)
HF_TOKEN=
